@import "tailwindcss";
.admin-custom-requests-page {
  width: min(100% - 48px, 1440px);
  margin: 0 auto;
  padding: 32px 0 64px;
  display: grid;
  gap: 28px;
}

.admin-custom-requests-header h1 {
  margin: 10px 0 0;
  font-family: var(--font-outfit), Arial, sans-serif;
  font-size: clamp(1.8rem, 3.6vw, 3rem);
  letter-spacing: -0.045em;
}

.admin-custom-requests-header p {
  margin: 10px 0 0;
  color: var(--text-muted);
}

.admin-custom-requests-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  align-items: flex-end;
}

.admin-custom-requests-table-wrap {
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: 0 14px 30px -24px rgba(24, 24, 27, 0.14);
}

.admin-custom-requests-table {
  min-width: 980px;
  width: 100%;
  border-collapse: collapse;
}

.admin-custom-requests-table th {
  text-align: left;
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
  font-weight: 800;
  padding: 14px 18px;
  background: var(--surface-soft);
  border-bottom: 1px solid var(--border);
}

.admin-custom-requests-table td {
  padding: 14px 18px;
  border-bottom: 1px solid rgba(228, 226, 220, 0.9);
  vertical-align: top;
}

.admin-custom-requests-table tbody tr:hover {
  background: rgba(250, 249, 245, 0.7);
}

.admin-custom-requests-table tbody tr:last-child td {
  border-bottom: none;
}

.cr-row-name {
  font-weight: 700;
}

.cr-row-phone {
  display: block;
  color: var(--text-muted);
  font-size: 0.9rem;
  margin-top: 2px;
}

.cr-row-desc {
  display: block;
  color: var(--text-muted);
  font-size: 0.88rem;
  max-width: 360px;
  margin-top: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cr-row-files {
  color: var(--text-muted);
  font-size: 0.9rem;
}

.cr-status-badge {
  display: inline-flex;
  align-items: center;
  width: max-content;
  border: 1px solid rgba(24, 24, 27, 0.08);
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.cr-status-new {
  background: rgba(204, 255, 0, 0.18);
  color: #354200;
}

.cr-status-contacted {
  background: rgba(14, 165, 233, 0.12);
  color: #075985;
}

.cr-status-in_progress {
  background: rgba(250, 204, 21, 0.16);
  color: #713f12;
}

.cr-status-completed {
  background: rgba(34, 197, 94, 0.14);
  color: #065f46;
}

.cr-status-cancelled {
  background: rgba(248, 113, 113, 0.16);
  color: #7f1d1d;
}

.cr-row-unread {
  background: rgba(204, 255, 0, 0.08);
}

.admin-custom-request-detail {
  width: min(100% - 48px, 1440px);
  margin: 0 auto;
  padding: 32px 0 64px;
  display: grid;
  gap: 24px;
}

.admin-custom-request-card {
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: 0 14px 30px -24px rgba(24, 24, 27, 0.14);
  overflow: hidden;
}

.admin-custom-request-card-header {
  padding: 20px 24px 12px;
  border-bottom: 1px solid rgba(228, 226, 220, 0.9);
  display: flex;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.admin-custom-request-card-body {
  padding: 22px 24px;
  display: grid;
  gap: 16px;
}

.cr-detail-field {
  display: grid;
  gap: 6px;
}

.cr-detail-label {
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
  font-weight: 800;
}

.cr-detail-value {
  font-size: 0.98rem;
  line-height: 1.7;
}

.cr-detail-files {
  display: grid;
  gap: 12px;
}

.cr-detail-file {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.cr-detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.cr-detail-status-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  align-items: center;
}

@media (max-width: 980px) {
  .admin-custom-requests-page,
  .admin-custom-request-detail {
    width: min(100% - 32px, 100%);
  }

  .admin-custom-requests-table-wrap {
    border-radius: 12px;
  }
}

.custom-request-section-home {
  width: min(100% - 48px, 1440px);
  margin: 0 auto 72px;
}

.custom-request-section-shell {
  border: 1px solid var(--border);
  border-radius: 24px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(250, 249, 245, 0.98));
  box-shadow: 0 24px 44px -30px rgba(24, 24, 27, 0.18);
  padding: clamp(28px, 6vw, 64px);
  display: grid;
  gap: 18px;
  text-align: center;
}

.custom-request-section-title {
  margin: 0;
  font-family: var(--font-outfit), Arial, sans-serif;
  font-size: clamp(1.8rem, 5vw, 3.6rem);
  letter-spacing: -0.05em;
  text-transform: uppercase;
}

.custom-request-section-subtitle {
  margin: 0 auto;
  max-width: 760px;
  color: var(--text-muted);
  font-size: clamp(0.98rem, 1.6vw, 1.06rem);
  line-height: 1.8;
}

.custom-request-section-cta {
  margin: 12px auto 0;
  min-height: 52px;
  padding: 0 32px;
  font-size: 0.78rem;
  letter-spacing: 0.12em;
}

.custom-request-page {
  padding: 32px 0 72px;
}

.custom-request-container {
  width: min(100% - 32px, 880px);
  margin: 0 auto;
}

.custom-request-form-shell {
  border: 1px solid var(--border);
  border-radius: 24px;
  background: var(--surface);
  box-shadow: 0 24px 44px -30px rgba(24, 24, 27, 0.18);
  overflow: hidden;
}

.custom-request-form {
  display: grid;
  gap: 28px;
  padding: clamp(22px, 5vw, 44px);
}

.custom-request-form-header h2 {
  margin: 0;
  font-family: var(--font-outfit), Arial, sans-serif;
  font-size: clamp(1.6rem, 4vw, 2.8rem);
  letter-spacing: -0.045em;
}

.custom-request-form-header p {
  margin: 10px 0 0;
  color: var(--text-muted);
}

.custom-request-section {
  display: grid;
  gap: 12px;
  padding: 20px 22px;
  border: 1px solid rgba(228, 226, 220, 0.92);
  border-radius: 16px;
  background: rgba(250, 249, 245, 0.6);
}

.custom-request-section-title {
  margin: 0;
  font-size: 0.98rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.custom-request-section-subtitle {
  margin: -4px 0 0;
  color: var(--text-muted);
  font-size: 0.92rem;
}

.custom-request-upload-card {
  display: grid;
  place-items: center;
  border: 1px dashed rgba(24, 24, 27, 0.18);
  border-radius: 14px;
  padding: 24px 20px;
  text-align: center;
  background: rgba(255, 255, 255, 0.7);
  cursor: pointer;
  transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.custom-request-upload-card.is-drag-over {
  border-color: rgba(204, 255, 0, 0.9);
  box-shadow: 0 0 0 4px rgba(204, 255, 0, 0.16);
  background: rgba(255, 255, 255, 0.9);
}

.custom-request-upload-content {
  display: grid;
  gap: 10px;
  justify-items: center;
}

.custom-request-upload-button {
  border: 1px solid rgba(24, 24, 27, 0.14);
  background: var(--surface);
  padding: 10px 18px;
  border-radius: 999px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 0.72rem;
}

.custom-request-upload-hint {
  margin: 0;
  color: var(--text-muted);
  font-size: 0.92rem;
}

.custom-request-upload-note {
  margin: 0;
  color: var(--text-muted);
  font-size: 0.86rem;
}

.custom-request-file-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 10px;
}

.custom-request-file-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1px solid rgba(228, 226, 220, 0.9);
  border-radius: 12px;
  padding: 10px 14px;
  background: var(--surface);
}

.custom-request-file-info {
  display: grid;
  gap: 2px;
}

.custom-request-file-name {
  font-weight: 600;
  font-size: 0.94rem;
}

.custom-request-file-size {
  color: var(--text-muted);
  font-size: 0.86rem;
}

.custom-request-file-remove {
  border: none;
  background: transparent;
  color: #7f1d1d;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 0.68rem;
}

.custom-request-dimensions-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.custom-request-info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}

.custom-request-quantity-field {
  max-width: 220px;
}

.custom-request-helper {
  margin: 6px 0 0;
  color: var(--text-muted);
  font-size: 0.88rem;
}

.custom-request-footer {
  display: grid;
  gap: 14px;
  justify-items: center;
  text-align: center;
}

.custom-request-reassurance {
  margin: 0;
  color: var(--text-muted);
}

.custom-request-submit {
  min-height: 56px;
  padding: 0 38px;
  font-size: 0.8rem;
  letter-spacing: 0.14em;
}

.custom-request-success {
  padding: clamp(28px, 8vw, 64px);
  text-align: center;
  display: grid;
  gap: 16px;
}

.custom-request-success h2 {
  margin: 0;
  font-family: var(--font-outfit), Arial, sans-serif;
  font-size: clamp(1.8rem, 5vw, 3rem);
  letter-spacing: -0.05em;
}

.custom-request-success p {
  margin: 0 auto;
  max-width: 620px;
  color: var(--text-muted);
}

.custom-request-success-id {
  font-weight: 700;
  color: var(--text);
}

.custom-request-success-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  justify-content: center;
}

.custom-request-success-link {
  display: inline-flex;
  align-items: center;
  min-height: 52px;
  padding: 0 32px;
  border: 1px solid var(--border);
  border-radius: 999px;
  text-decoration: none;
  color: var(--text);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-size: 0.74rem;
}

@media (max-width: 980px) {
  .custom-request-dimensions-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .custom-request-info-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .custom-request-dimensions-grid {
    grid-template-columns: 1fr;
  }
}
